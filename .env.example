# ---- Supabase ----
# Project Settings -> API Keys
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co

# Public key. Paste the new "publishable" key (sb_publishable_...) or the
# legacy anon key — both work. Legacy keys are being retired during 2026.
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxx

# Server only, NEVER expose to the browser. New "secret" key (sb_secret_...)
# or the legacy service_role key.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxxxxxxxxxxx

# ---- App ----
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- wire.mn payments (https://app.wire.mn) ----
# sk_test_… while testing, sk_live_… in production
WIRE_API_KEY=sk_test_xxxxxxxxxxxx
# Shown once when you create the webhook endpoint
WIRE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxx
# Comma separated operator ids. Leave empty in live mode to allow every
# operator enabled on your account. Test mode uses "sandbox".
WIRE_OPERATORS=sandbox
# Override only if wire.mn tells you to
# WIRE_API_BASE=https://api.wire.mn/v1

# ---- On-device AI upscaling ----
# Works out of the box: a free MIT-licensed ESRGAN-slim model (900 KB) is
# fetched from jsDelivr and runs in the browser. Nothing is uploaded.
# Set to 1 to turn it off entirely:
# NEXT_PUBLIC_DISABLE_AI=1
# Or point at your own TensorFlow.js layers model:
# NEXT_PUBLIC_SR_MODEL_URL=/models/my-model/model.json
